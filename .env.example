# Copie para ".env" e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Config do SDK)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Console do Firebase > Cloud Messaging > Certificados push na Web (gera a "chave VAPID")
VITE_FIREBASE_VAPID_KEY=

# Base URL das Cloud Functions, ex.: https://us-central1-<project-id>.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=
