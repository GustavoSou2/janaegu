rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Nenhuma leitura/escrita pública: todo o caminho do convidado passa pelas
    // Cloud Functions (Admin SDK, que ignora estas regras). O painel admin
    // autenticado usa o SDK do cliente diretamente.
    match /families/{familyId} {
      allow read, write: if isAdmin();

      match /guests/{guestId} {
        allow read, write: if isAdmin();
      }
    }

    // Dados do evento: leitura pública (sem informação sensível), escrita só do admin.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tokens de push: só as Cloud Functions escrevem (Admin SDK); admin pode ler para debug.
    match /pushSubscriptions/{subId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
